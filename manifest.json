{
  "manifest_version": 3,
  "name": "e-MASTER Auto Fill",
  "version": "3.0.0",
  "description": "Auto-fill Aktivitas Kinerja Harian di Si-MASTER BKD Jatim — tanpa Tampermonkey",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://master.bkd.jatimprov.go.id/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
